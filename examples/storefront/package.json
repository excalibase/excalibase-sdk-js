{
  "name": "excalibase-storefront-demo",
  "private": true,
  "version": "0.0.1",
  "description": "A small store built on Excalibase: public catalog, customers' own carts and orders, a staff role, a tracked function, realtime order status and a private Redis.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/server.mjs",
    "test": "node --test server/*.test.mjs setup/*.test.mjs && vitest run",
    "setup": "node setup/setup.mjs"
  },
  "dependencies": {
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@excalibase/sdk": "0.11.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
